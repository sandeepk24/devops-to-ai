# LLM inference platform — local environment
# Copy to .env:  cp .env.example .env
# Path A (laptop): leave INFERENCE_URL pointing at mock-inference.
# Path B (GPU): set INFERENCE_URL=http://vllm:8000 and uncomment vllm in compose.

COMPOSE_PROJECT_NAME=llm-platform

# Gateway
GATEWAY_PORT=8080
API_KEYS=dev-key,demo-key
GATEWAY_API_KEY=dev-key
# Tip: set RATE_LIMIT_RPM=10 temporarily to prove 429s in smoke_test
RATE_LIMIT_RPM=60
INFERENCE_URL=http://mock-inference:8000
CANARY_INFERENCE_URL=http://mock-inference:8000
CANARY_PERCENT=10

# RAG
RAG_PORT=8081
QDRANT_URL=http://qdrant:6333
GATEWAY_URL=http://inference-gateway:8080
# Path A uses a hash embedder in code; this name is a hint for the stretch upgrade
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=4

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# vLLM (GPU path only — leave commented for mock)
# HF_TOKEN=
# VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
