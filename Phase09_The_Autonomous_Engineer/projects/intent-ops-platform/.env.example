# Intent ops platform — local env
COMPOSE_PROJECT_NAME=intent-ops-platform

# Startup default only — flip it live with scripts/set_kill_switch.sh,
# no restart needed (see POST /v1/admin/kill_switch).
KILL_SWITCH=false
ALLOWED_ENVIRONMENTS=dev,staging
ALLOWED_ACTIONS=rollback,scale_replicas
MAX_ATTEMPTS_CAP=2
MAX_REPLICAS=16
